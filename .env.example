# IMNEHNET SSH connection template
# Copy to .env for local use. Never commit .env or real credentials.
# For GitHub Actions, store secret values in repository/environment Secrets.

SERVER_IMNEHNET_SSH_HOST=server-imnehnet
SERVER_IMNEHNET_SSH_USER=imnehnet
SERVER_IMNEHNET_SSH_PASSWORD=

IAAS_MGMT_SSH_HOST=iaas-mgmt
IAAS_MGMT_SSH_USER=iaas
IAAS_MGMT_SSH_PASSWORD=

LAB_ENV_SSH_HOST=lab-env
LAB_ENV_SSH_USER=lab
LAB_ENV_SSH_PASSWORD=

LAB_ATK_SSH_HOST=lab-atk
LAB_ATK_SSH_USER=labatk
LAB_ATK_SSH_PASSWORD=
