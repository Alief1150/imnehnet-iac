#!/usr/bin/env python3
"""Aggregate IMNEHNET audit reports without copying raw logs."""

import argparse
import json
import subprocess
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

DEFAULT_CONFIGS = [
    Path.home() / ".config/imnehnet-audit/nodes.json",
    Path("/etc/imnehnet-audit/nodes.json"),
]
REPORT = "/usr/local/sbin/imnehnet-audit-report"
DEFAULT_TIMEZONE = "Asia/Jakarta"


def run(command):
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"exit {result.returncode}")
    return json.loads(result.stdout or "[]")


def node_events(node):
    if node.get("local"):
        command = ["sudo", "-n", REPORT, "--today", "--json"]
    else:
        command = [
            "ssh",
            "-o", "BatchMode=yes",
            "-o", "IdentitiesOnly=yes",
            "-o", "ConnectTimeout=8",
        ]
        if node.get("identity"):
            command += ["-i", str(Path(node["identity"]).expanduser())]
        if node.get("known_hosts"):
            command += ["-o", f"UserKnownHostsFile={Path(node['known_hosts']).expanduser()}"]
        command += [f"{node['user']}@{node['host']}", "sudo", "-n", REPORT, "--today", "--json"]
    try:
        return run(command)
    except (RuntimeError, json.JSONDecodeError, KeyError) as exc:
        return [{
            "time": datetime.now().astimezone().isoformat(),
            "node": node.get("name", "unknown"),
            "machine": "UNKNOWN / LOCAL",
            "tailnet_user": "UNKNOWN / LOCAL",
            "source_ip": "unknown",
            "linux_user": "unknown",
            "actor": "Unknown",
            "action": "ERROR",
            "target": str(exc),
        }]


def load_config(path=None):
    candidates = [Path(path).expanduser()] if path else DEFAULT_CONFIGS
    for candidate in candidates:
        if candidate.is_file():
            data = json.loads(candidate.read_text(encoding="utf-8"))
            return data.get("nodes", [])
    return [{"name": "server-imnehnet", "local": True}]


def events_for_date(events, nodes, timezone_name):
    zone = ZoneInfo(timezone_name)
    now = datetime.now(zone)
    target_date = now.date()
    selected = []
    represented = set()

    for event in events:
        node = event.get("node", "unknown")
        if event.get("action") == "ERROR":
            selected.append(event)
            represented.add(node)
            continue
        try:
            stamp = datetime.fromisoformat(str(event["time"]))
            if stamp.tzinfo is None:
                stamp = stamp.replace(tzinfo=zone)
            stamp = stamp.astimezone(zone)
        except (KeyError, TypeError, ValueError):
            continue
        if stamp.date() != target_date:
            continue
        normalized = dict(event)
        normalized["time"] = stamp.isoformat()
        selected.append(normalized)
        represented.add(node)

    for node in nodes:
        name = node.get("name", "unknown")
        if name in represented:
            continue
        selected.append({
            "time": now.isoformat(),
            "node": name,
            "actor": "-",
            "source_ip": "-",
            "machine": "-",
            "tailnet_user": "-",
            "linux_user": "-",
            "action": "NOACTIVITY",
            "target": f"No activity on {target_date.isoformat()} WIB",
        })
    return selected


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--config")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--limit", type=int, default=100)
    parser.add_argument("--timezone", default=DEFAULT_TIMEZONE)
    parser.add_argument("--all-returned", action="store_true")
    args = parser.parse_args()

    nodes = load_config(args.config)
    events = []
    for node in nodes:
        events.extend(node_events(node))
    if not args.all_returned:
        events = events_for_date(events, nodes, args.timezone)
    events.sort(key=lambda item: item.get("time", ""), reverse=True)
    events = events[:max(1, args.limit)]

    if args.json:
        print(json.dumps(events, ensure_ascii=False))
        return

    print("TIMESTAMP                 NODE          ACTOR                 SOURCE IP        TAILSCALE MACHINE  TAILSCALE USER        LINUX USER  ACTION      TARGET")
    print("------------------------  ------------  --------------------  ---------------  -----------------  --------------------  ----------  ----------  ----------------------------")
    for event in events:
        stamp = str(event.get("time", "unknown"))[:24]
        node = str(event.get("node", "unknown"))[:12]
        actor = str(event.get("actor") or "Unknown")[:20]
        source_ip = str(event.get("source_ip") or "unknown")[:15]
        machine = str(event.get("machine") or "UNKNOWN / LOCAL")[:17]
        tailnet_user = str(event.get("tailnet_user") or "UNKNOWN / LOCAL")[:20]
        linux_user = str(event.get("linux_user") or "unknown")[:10]
        action = str(event.get("action") or "unknown")[:10]
        target = str(event.get("target") or "unknown")[:28]
        print(f"{stamp:<24}  {node:<12}  {actor:<20}  {source_ip:<15}  {machine:<17}  {tailnet_user:<20}  {linux_user:<10}  {action:<10}  {target}")


if __name__ == "__main__":
    main()
