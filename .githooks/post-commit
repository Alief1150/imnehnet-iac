#!/usr/bin/env bash
set -euo pipefail

if [[ "${IMNEHNET_NO_AUTO_PUSH:-0}" == "1" ]]; then
  echo "Auto-push disabled by IMNEHNET_NO_AUTO_PUSH=1"
  exit 0
fi

branch="$(git branch --show-current)"
if [[ -z "$branch" ]]; then
  exit 0
fi

echo "Auto-pushing commit to origin/$branch..."
git push origin "$branch"
